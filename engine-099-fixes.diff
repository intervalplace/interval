>         if (!sl) continue;
>         if (exact ? sl.item !== item : !fills(item, sl.item)) continue;
>         const take = Math.min(sl.qty ?? 1, left);
>         removeItem(inv, i, take);
>         left -= take;
>       }
>     };
>     spend(true);
>     spend(false);
>   }
> }
